{
    "name": "magestyapps/module-web-images",
    "description": "Upload SVG and WebP images in Magento 2",
    "require": {
        "php": ">=7.4",
        "magento/module-backend": ">=102.0.7",
        "hyva-themes/magento2-theme-module": "^1.3.10"
    },
    "type": "magento2-module",
    "version": "1.2.1",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "autoload": {
        "files": [ "registration.php" ],
        "psr-4": {
            "MagestyApps\\WebImages\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
